diff --git a/src/rnd.c b/src/rnd.c
index 76ef6a69..df03b942 100644
--- a/src/rnd.c
+++ b/src/rnd.c
@@ -2,13 +2,14 @@
 
 #include "rnd.h"
 #include "hw.h"
+#include "log.h"
 #include "types.h"
 
 /* -------------------------------------------------------------------------- */
 
 /* -------------------------------------------------------------------------- */
 
-uint16_t rnd_0_nm1(uint16_t n, uint32_t *seed)
+uint16_t rnd_0_nm1_impl(uint16_t n, uint32_t *seed)
 {   /* NOTE: This code is simplified and contains hacks.
        Assembler code in this function would be more appropriate. */
     uint16_t r = 0;
@@ -52,9 +53,31 @@ uint16_t rnd_0_nm1(uint16_t n, uint32_t *seed)
     return r % n;
 }
 
-uint16_t rnd_1_n(uint16_t n, uint32_t *seed)
+uint16_t rnd_0_nm1_traced(uint16_t n, uint32_t *seed, const char *file, int line)
 {
-    return 1 + rnd_0_nm1(n, seed);
+    uint32_t seed_in = *seed;
+    uint16_t result = rnd_0_nm1_impl(n, seed);
+    LOG_EVENT(0, "rng_call",
+              "n=%u seed_in=%u seed_out=%u result=%u caller=%s:%d",
+              (unsigned)n, (unsigned)seed_in, (unsigned)*seed,
+              (unsigned)result, file, line);
+    return result;
+}
+
+uint16_t rnd_1_n_impl(uint16_t n, uint32_t *seed)
+{
+    return 1 + rnd_0_nm1_impl(n, seed);
+}
+
+uint16_t rnd_1_n_traced(uint16_t n, uint32_t *seed, const char *file, int line)
+{
+    uint32_t seed_in = *seed;
+    uint16_t result = rnd_1_n_impl(n, seed);
+    LOG_EVENT(0, "rng_call",
+              "n=%u seed_in=%u seed_out=%u result=%u caller=%s:%d",
+              (unsigned)n, (unsigned)seed_in, (unsigned)*seed,
+              (unsigned)result, file, line);
+    return result;
 }
 
 uint32_t rnd_get_new_seed(void)
