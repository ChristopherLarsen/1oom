+/* DRG-HUMAN-GATE 2026-09-29: when MOO_INPUT_LOG names a file, append one
+ * line per consumed input: <seq>\t<list title>\t<prompt>\t<answer>. The
+ * human-gate runner uses it to fail on prompt/answer misalignment. */
+static FILE *ui_input_log_f = NULL;
+static bool ui_input_log_checked = false;
+static int ui_input_log_seq = 0;
+static const char *ui_input_log_title = NULL;
+/* DRG-HUMAN-GATE: when MOO_PROMPT_MARK is set, every input read is preceded
+ * by one stdout line "@@PROMPT\t<title>\t<prompt>\t<opts>" where opts is
+ * "value^key^display" for each selectable list item, joined by '|'. Lets a
+ * driver answer prompts by kind instead of by position. */
+static char ui_input_opts[4096];
+
+static void ui_input_mark(const char *prompt)
+{
+    static int mark = -1;
+    if (mark < 0) {
+        const char *e = getenv("MOO_PROMPT_MARK");
+        mark = (e && *e) ? 1 : 0;
+    }
+    if (mark) {
+        printf("\n@@PROMPT\t%s\t%s\t%s\n", ui_input_log_title ? ui_input_log_title : "", prompt ? prompt : "", ui_input_opts);
+        fflush(stdout);
+    }
+    ui_input_opts[0] = '\0';
+}
+
+static void ui_input_log(const char *prompt, const char *answer)
+{
+    if (!ui_input_log_checked) {
+        const char *path = getenv("MOO_INPUT_LOG");
+        ui_input_log_checked = true;
+        if (path && *path) {
+            ui_input_log_f = fopen(path, "w");
+        }
+    }
+    if (ui_input_log_f) {
+        fprintf(ui_input_log_f, "%d\t%s\t%s\t%s\n", ++ui_input_log_seq,
+                ui_input_log_title ? ui_input_log_title : "", prompt ? prompt : "", answer ? answer : "<EOF>");
+        fflush(ui_input_log_f);
+    }
+    ui_input_log_title = NULL;
+}
+
+void ui_input_event(const char *name, const char *fmt, ...)
+{
+    const char *e = getenv("MOO_PROMPT_MARK");
+    va_list ap;
+    if (!(e && *e)) {
+        return;
+    }
+    printf("\n@@EVENT\t%s\t", name);
+    va_start(ap, fmt);
+    vprintf(fmt, ap);
+    va_end(ap);
+    putchar('\n');
+    fflush(stdout);
+}
+
