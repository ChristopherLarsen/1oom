+static bool jumpscreen_orbit_has_ships(const struct game_s *g, player_id_t pi, uint8_t planet_i)
+{
+    const empiretechorbit_t *ep = &(g->eto[pi]);
+    for (int j = 0; j < ep->shipdesigns_num; ++j) {
+        if (ep->orbit[planet_i].ships[j] > 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void jumpscreen_seed_battle_orbit(struct game_s *g, player_id_t pi, uint8_t planet_i)
+{
+    empiretechorbit_t *ep = &(g->eto[pi]);
+    if (ep->shipdesigns_num == 0) {
+        ep->shipdesigns_num = 1;
+    }
+    if (!jumpscreen_orbit_has_ships(g, pi, planet_i) && ep->shipdesigns_num > 0) {
+        ep->orbit[planet_i].ships[0] = 2;
+    }
+}
+
+static int jump_battle(struct game_s *g, const char *args)
+{
+    (void)args;
+    player_id_t pi = g->active_player;
+    player_id_t opponent = PLAYER_NONE;
+    uint8_t planet_i = jumpscreen_first_contested_planet(g, pi, &opponent);
+    if (planet_i == PLANET_NONE || opponent == PLAYER_NONE) {
+        for (player_id_t o = PLAYER_0; o < g->players; ++o) {
+            if (o == pi) continue;
+            if (IS_ALIVE(g, o)) { opponent = o; break; }
+        }
+        planet_i = jumpscreen_first_own_planet(g, pi);
+        if (planet_i == PLANET_NONE) {
+            planet_i = 0;
+        }
+        if (opponent == PLAYER_NONE) {
+            log_error("Jumpscreen: battle needs >=1 alive opponent; none found\n");
+            return 2;
+        }
+        log_message("Jumpscreen: battle using fallback (own homeworld + first opponent), planet_i=%d opp=%d\n",
+                    planet_i, opponent);
+    }
+    if (g->planet[planet_i].owner == PLAYER_NONE) {
+        uint8_t own_planet_i = jumpscreen_first_own_planet(g, pi);
+        if (own_planet_i != PLANET_NONE) {
+            planet_i = own_planet_i;
+            log_message("Jumpscreen: battle moved neutral-orbit capture to own planet_i=%d\n", planet_i);
+        }
+    }
+    jumpscreen_seed_battle_orbit(g, pi, planet_i);
+    jumpscreen_seed_battle_orbit(g, opponent, planet_i);
+    struct battle_s bt[1];
+    memset(bt, 0, sizeof(*bt));
+    bt->g = g;
+    bt->flag_human_att = true;
+    game_battle_prepare(bt, /*party_r=*/pi, /*party_l=*/opponent, planet_i);
+    game_battle_jumpscreen_prepare_active(bt);
+    if (bt->items_num == 0) {
+        log_error("Jumpscreen: battle has no ship/base items at planet_i=%d\n", planet_i);
+        return 2;
+    }
+    log_message("Jumpscreen: battle pi=%d opp=%d planet_i=%d items=%d cur_item=%d turn=%d\n",
+                pi, opponent, planet_i, bt->items_num, bt->cur_item, bt->num_turn);
+    ui_battle_jumpscreen_draw_active(bt);
+    return 0;
+}
