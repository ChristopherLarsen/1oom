+/* agent-orion diagnostic: explore-event popup (game_turn.c:1118 call site).
+   args: planet=N (default: first own planet), scanner=0|1, colony=0|1. */
+static int jump_explore(struct game_s *g, const char *args)
+{
+    char buf[32];
+    int planet_i = -1;
+    bool by_scanner = false, colony = false;
+    if (jumpscreen_arg_get(args, "planet", buf, sizeof(buf))) {
+        planet_i = atoi(buf);
+    }
+    if (jumpscreen_arg_get(args, "scanner", buf, sizeof(buf))) {
+        by_scanner = (atoi(buf) != 0);
+    }
+    if (jumpscreen_arg_get(args, "colony", buf, sizeof(buf))) {
+        colony = (atoi(buf) != 0);
+    }
+    if ((planet_i < 0) || (planet_i >= g->galaxy_stars)) {
+        log_error("Jumpscreen: explore planet=%d out of range 0..%d\n", planet_i, g->galaxy_stars - 1);
+        return 1;
+    }
+    ui_explore(g, g->active_player, (uint8_t)planet_i, by_scanner, colony);
+    return 0;
+}
